}

model AuditEvent {
  id             String   @id @default(cuid())
  userId         String?
  userRoleAtTime String?
  action         String
  module         String
  entityType     String
  entityId       String?
  oldValueJson   String?
  newValueJson   String?
  ipAddress      String?
  userAgent      String?
  branchId       String?
  sessionId      String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
  @@map("audit_events")
}

model AiSignal {
  id                 String   @id @default(cuid())
  signalType         String
  module             String
  branchId           String?
  entityType         String?
  entityId           String?
  value              Float?
  confidence         Float?
  supportingDataJson String?
  generatedAt        DateTime @default(now())
  expiresAt          DateTime?
  createdAt          DateTime @default(now())

  recommendations AiRecommendation[]
  @@map("ai_signals")
}

model AiRecommendation {
  id                 String    @id @default(cuid())
  signalId           String?
  type               String
  title              String
  description        String
  supportingDataJson String?
  priority           String    @default("MEDIUM")
  status             String    @default("PENDING")
  assignedTo         String?
  createdAt          DateTime  @default(now())
  decidedAt          DateTime?
  decidedBy          String?
  decisionNotes      String?

  signal AiSignal? @relation(fields: [signalId], references: [id])
  @@map("ai_recommendations")
}

model GoldRate {
  id        String   @id @default(cuid())
  date      DateTime @unique
  rate22kt  Float
  rate18kt  Float
  rate24kt  Float
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("gold_rates")
}