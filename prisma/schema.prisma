generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String?   @unique
  phone              String?   @unique
  passwordHash       String?
  avatarUrl          String?
  type               String    @default("INTERNAL")
  status             String    @default("ACTIVE")
  emailVerifiedAt    DateTime?
  mfaEnabled         Boolean   @default(false)
  lastLoginAt        DateTime?
  forcePasswordReset Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?

  roles         UserRole[]
  sessions      Session[]
  customer      Customer?
  employee      Employee?
  vendor        Vendor?
  notifications Notification[]
  auditEvents   AuditEvent[]
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  scope       String   @default("BRANCH")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  permissions RolePermission[]
  userRoles   UserRole[]
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@unique([module, resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  branchId  String?
  grantedBy String
  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  role   Role    @relation(fields: [roleId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  @@map("user_roles")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  deviceName   String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
  @@map("sessions")
}

model Company {
  id                   String   @id @default(cuid())
  legalName            String
  tradeName            String
  gstNumber            String?
  panNumber            String?
  logoUrl              String?
  registeredAddress    String?
  corporatePhone       String?
  corporateEmail       String?
  fiscalYearStartMonth Int      @default(4)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@map("company")
}

model Branch {
  id                   String    @id @default(cuid())
  name                 String
  code                 String    @unique
  type                 String    @default("CORPORATE")
  status               String    @default("ACTIVE")
  address              String?
  city                 String?
  state                String?
  pincode              String?
  latitude             Float?
  longitude            Float?
  phone                String?
  email                String?
  managerId            String?
  openedOn             DateTime?
  gstNumber            String?
  targetMonthlyRevenue Float?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?

  userRoles          UserRole[]
  employees          Employee[]
  inventoryLocations InventoryLocation[]
  inventoryStock     InventoryStock[]
  leads              Lead[]
  appointments       Appointment[]
  sales              Sale[]
  repairTickets      RepairTicket[]
  customOrders       CustomOrder[]
  jobs               Job[]
  branchFinancials   BranchFinancial[]
  stockTransfersFrom StockTransfer[] @relation("TransferFrom")
  stockTransfersTo   StockTransfer[] @relation("TransferTo")
  franchiseReports   FranchiseMonthlyReport[]
  @@map("branches")
}

model Department {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent       Department?  @relation("SubDept", fields: [parentId], references: [id])
  children     Department[] @relation("SubDept")
  designations Designation[]
  employees    Employee[]
  jobs         Job[]
  @@map("departments")
}

model Designation {
  id           String   @id @default(cuid())
  name         String
  departmentId String
  grade        String?
  minSalary    Float?
  maxSalary    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  employees  Employee[]
  jobs       Job[]
  offers     Offer[]
  @@map("designations")
}

model Shift {
  id           String   @id @default(cuid())
  branchId     String?
  name         String
  startTime    String
  endTime      String
  graceMinutes Int      @default(10)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendance Attendance[]
  @@map("shifts")
}

model Customer {
  id                String    @id @default(cuid())
  userId            String?   @unique
  name              String
  phone             String    @unique
  alternatePhone    String?
  email             String?
  dob               DateTime?
  anniversary       DateTime?
  gender            String?
  kycStatus         String    @default("PENDING")
  loyaltyTier       String?
  loyaltyPoints     Int       @default(0)
  customerSince     DateTime?
  primaryBranchId   String?
  acquisitionSource String?
  segment           String?
  notes             String?
  isBlocked         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?

  user              User?       @relation(fields: [userId], references: [id])
  addresses         CustomerAddress[]
  leads             Lead[]
  appointments      Appointment[]
  quotations        Quotation[]
  sales             Sale[]
  repairTickets     RepairTicket[]
  customOrders      CustomOrder[]
  reservations      Reservation[]
  schemeEnrollments CustomerSchemeEnrollment[]
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  label      String?
  type       String   @default("HOME")
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  @@map("customer_addresses")
}

model Category {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  parentId     String?
  iconUrl      String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent   Category?  @relation("Subcategory", fields: [parentId], references: [id])
  children Category[] @relation("Subcategory")
  products Product[]
  requisitions PurchaseRequisition[]
  @@map("categories")
}

model Collection {
  id            String    @id @default(cuid())
  name          String
  theme         String?
  coverImageUrl String?
  launchDate    DateTime?
  endDate       DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products Product[]
  @@map("collections")
}

model Product {
  id               String    @id @default(cuid())
  sku              String    @unique
  name             String
  categoryId       String
  collectionId     String?
  metalType        String
  purity           String
  makingChargeType String    @default("PERCENT_ON_WEIGHT")
  makingChargeValue Float    @default(0)
  wastagePercent   Float?
  hasStones        Boolean   @default(false)
  stoneDescription String?
  gender           String?
  occasionTags     String?
  description      String?
  status           String    @default("ACTIVE")
  isCustomizable   Boolean   @default(false)
  minWeightGm      Float?
  maxWeightGm      Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?

  category   Category    @relation(fields: [categoryId], references: [id])
  collection Collection? @relation(fields: [collectionId], references: [id])
  items      JewelleryItem[]
  media      ProductMedia[]
  @@map("products")
}

model JewelleryItem {
  id               String    @id @default(cuid())
  productId        String
  itemCode         String    @unique
  huid             String?   @unique
  batchNo          String?
  metalType        String
  purity           String
  grossWeightGm    Float
  netWeightGm      Float
  stoneWeightGm    Float?
  stoneDescription String?
  makingCharge     Float     @default(0)
  wastagePercent   Float?
  tagPrice         Float     @default(0)
  costPrice        Float?
  status           String    @default("IN_STOCK")
  branchId         String
  locationId       String?
  vendorId         String?
  receivedAt       DateTime  @default(now())
  isHallmarked     Boolean   @default(false)
  hallmarkedAt     DateTime?
  isCertified      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?

  product       Product            @relation(fields: [productId], references: [id])
  location      InventoryLocation? @relation(fields: [locationId], references: [id])
  media         ProductMedia[]
  certificates  Certificate[]
  stock         InventoryStock?
  movements     InventoryMovement[]
  reservations  Reservation[]
  transferItems StockTransferItem[]
  saleItems     SaleItem[]
  repairTickets RepairTicket[]
  hallmarkRecord HallmarkRecord?
  grnItems      GoodsReceiptItem[]
  @@map("jewellery_items")
}

model ProductMedia {
  id           String   @id @default(cuid())
  productId    String?
  itemId       String?
  url          String
  type         String   @default("IMAGE")
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  uploadedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product?       @relation(fields: [productId], references: [id])
  item    JewelleryItem? @relation(fields: [itemId], references: [id])
  @@map("product_media")
}

model Certificate {
  id          String   @id @default(cuid())
  itemId      String
  type        String
  certNumber  String
  issuedBy    String
  issuedAt    DateTime
  validUntil  DateTime?
  documentUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item JewelleryItem @relation(fields: [itemId], references: [id])
  @@map("certificates")
}

model HallmarkRecord {
  id             String   @id @default(cuid())
  itemId         String   @unique
  huid           String
  purityVerified String
  centerCode     String?
  hallmarkedAt   DateTime
  certificateUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  item JewelleryItem @relation(fields: [itemId], references: [id])
  @@map("hallmark_records")
}

model InventoryLocation {
  id           String   @id @default(cuid())
  branchId     String
  name         String
  code         String
  type         String   @default("VAULT")
  capacity     Int?
  currentCount Int      @default(0)
  status       String   @default("ACTIVE")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isDeleted    Boolean  @default(false)

  branch        Branch          @relation(fields: [branchId], references: [id])
  items         JewelleryItem[]
  stock         InventoryStock[]
  movementsFrom InventoryMovement[] @relation("MovedFrom")
  movementsTo   InventoryMovement[] @relation("MovedTo")

  @@unique([branchId, code])
  @@map("inventory_locations")
}

model InventoryStock {
  id         String   @id @default(cuid())
  itemId     String   @unique
  branchId   String
  locationId String?
  status     String   @default("IN_STOCK")
  asOf       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item     JewelleryItem      @relation(fields: [itemId], references: [id])
  branch   Branch             @relation(fields: [branchId], references: [id])
  location InventoryLocation? @relation(fields: [locationId], references: [id])
  @@map("inventory_stock")
}

model InventoryMovement {
  id             String   @id @default(cuid())
  itemId         String
  movementType   String
  fromBranchId   String?
  toBranchId     String?
  fromLocationId String?
  toLocationId   String?
  referenceType  String?
  referenceId    String?
  movedBy        String
  movedAt        DateTime @default(now())
  notes          String?
  itemValueAtMove Float?
  createdAt      DateTime @default(now())

  item         JewelleryItem      @relation(fields: [itemId], references: [id])
  fromLocation InventoryLocation? @relation("MovedFrom", fields: [fromLocationId], references: [id])
  toLocation   InventoryLocation? @relation("MovedTo", fields: [toLocationId], references: [id])
  @@map("inventory_movements")
}

model Reservation {
  id            String   @id @default(cuid())
  itemId        String
  customerId    String
  branchId      String
  leadId        String?
  reservedBy    String
  reservedAt    DateTime @default(now())
  expiresAt     DateTime
  status        String   @default("ACTIVE")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item     JewelleryItem @relation(fields: [itemId], references: [id])
  customer Customer      @relation(fields: [customerId], references: [id])
  @@map("reservations")
}

model StockTransfer {
  id           String    @id @default(cuid())
  transferNo   String    @unique
  fromBranchId String
  toBranchId   String
  initiatedBy  String
  approvedBy   String?
  status       String    @default("DRAFT")
  dispatchedAt DateTime?
  receivedAt   DateTime?
  notes        String?
  totalItems   Int       @default(0)
  totalValue   Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  fromBranch Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  items      StockTransferItem[]
  @@map("stock_transfers")
}

model StockTransferItem {
  id             String   @id @default(cuid())
  transferId     String
  itemId         String
  dispatchStatus String   @default("PENDING")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transfer StockTransfer @relation(fields: [transferId], references: [id])
  item     JewelleryItem @relation(fields: [itemId], references: [id])
  @@map("stock_transfer_items")
}

model Lead {
  id              String    @id @default(cuid())
  customerId      String?
  branchId        String
  name            String
  phone           String
  email           String?
  source          String    @default("WALK_IN")
  interest        String?
  budgetMin       Float?
  budgetMax       Float?
  status          String    @default("NEW")
  assignedTo      String?
  lostReason      String?
  priority        String    @default("MEDIUM")
  nextActionAt    DateTime?
  convertedAt     DateTime?
  convertedSaleId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isDeleted       Boolean   @default(false)

  customer     Customer?         @relation(fields: [customerId], references: [id])
  branch       Branch            @relation(fields: [branchId], references: [id])
  interactions LeadInteraction[]
  appointments Appointment[]
  quotations   Quotation[]
  @@map("leads")
}

model LeadInteraction {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  direction String   @default("OUTBOUND")
  notes     String?
  doneBy    String
  doneAt    DateTime @default(now())
  outcome   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id])
  @@map("lead_interactions")
}

model Appointment {
  id              String    @id @default(cuid())
  customerId      String?
  leadId          String?
  branchId        String
  scheduledAt     DateTime
  durationMinutes Int       @default(60)
  purpose         String    @default("BROWSE")
  status          String    @default("SCHEDULED")
  assignedTo      String?
  walkIn          Boolean   @default(false)
  notes           String?
  outcomeNotes    String?
  reminderSent    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  branch   Branch    @relation(fields: [branchId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id])
  @@map("appointments")
}

model Quotation {
  id            String    @id @default(cuid())
  quotationNo   String    @unique
  customerId    String
  branchId      String
  leadId        String?
  createdBy     String
  status        String    @default("DRAFT")
  validUntil    DateTime
  metalRate22kt Float?
  subtotal      Float     @default(0)
  discountAmount Float    @default(0)
  gstAmount     Float     @default(0)
  totalAmount   Float     @default(0)
  notes         String?
  convertedSaleId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)

  customer  Customer        @relation(fields: [customerId], references: [id])
  lead      Lead?           @relation(fields: [leadId], references: [id])
  items     QuotationItem[]
  discounts Discount[]
  @@map("quotations")
}

model QuotationItem {
  id              String   @id @default(cuid())
  quotationId     String
  itemId          String
  listedPrice     Float
  discountType    String?
  discountValue   Float?
  discountedPrice Float
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id])
  @@map("quotation_items")
}

model Sale {
  id            String   @id @default(cuid())
  saleNo        String   @unique
  quotationId   String?
  customerId    String
  branchId      String
  saleType      String   @default("PURCHASE")
  saleDate      DateTime @default(now())
  metalRate22kt Float?
  subtotal      Float    @default(0)
  discountAmount Float   @default(0)
  gstAmount     Float    @default(0)
  totalAmount   Float    @default(0)
  amountPaid    Float    @default(0)
  balanceDue    Float    @default(0)
  paymentStatus String   @default("PENDING")
  salespersonId String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isDeleted     Boolean  @default(false)

  customer  Customer   @relation(fields: [customerId], references: [id])
  branch    Branch     @relation(fields: [branchId], references: [id])
  items     SaleItem[]
  payments  Payment[]
  discounts Discount[]
  invoice   Invoice?
  refunds   Refund[]
  @@map("sales")
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  itemId         String
  unitPrice      Float
  discountAmount Float    @default(0)
  gstRate        Float    @default(3)
  gstAmount      Float    @default(0)
  finalPrice     Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sale Sale          @relation(fields: [saleId], references: [id])
  item JewelleryItem @relation(fields: [itemId], references: [id])
  @@map("sale_items")
}

model Invoice {
  id          String    @id @default(cuid())
  saleId      String    @unique
  invoiceNo   String    @unique
  invoiceDate DateTime  @default(now())
  gstType     String    @default("CGST_SGST")
  pdfUrl      String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sale Sale @relation(fields: [saleId], references: [id])
  @@map("invoices")
}

model Payment {
  id          String   @id @default(cuid())
  saleId      String
  amount      Float
  method      String
  referenceNo String?
  status      String   @default("CAPTURED")
  paidAt      DateTime @default(now())
  capturedBy  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sale Sale @relation(fields: [saleId], references: [id])
  @@map("payments")
}

model Discount {
  id          String    @id @default(cuid())
  saleId      String?
  quotationId String?
  type        String
  value       Float
  amount      Float
  reason      String
  requestedBy String
  approvedBy  String?
  status      String    @default("PENDING")
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sale      Sale?      @relation(fields: [saleId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])
  @@map("discounts")
}

model Refund {
  id          String    @id @default(cuid())
  saleId      String
  amount      Float
  reason      String
  method      String
  status      String    @default("PENDING")
  initiatedBy String
  approvedBy  String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sale Sale @relation(fields: [saleId], references: [id])
  @@map("refunds")
}

model LoyaltyScheme {
  id                String   @id @default(cuid())
  name              String
  type              String
  durationMonths    Int
  installmentAmount Float?
  bonusMonth        Int?
  terms             String?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  enrollments CustomerSchemeEnrollment[]
  @@map("loyalty_schemes")
}

model CustomerSchemeEnrollment {
  id            String    @id @default(cuid())
  customerId    String
  schemeId      String
  branchId      String
  enrolledAt    DateTime  @default(now())
  maturityDate  DateTime
  monthlyAmount Float
  totalPaid     Float     @default(0)
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer Customer      @relation(fields: [customerId], references: [id])
  scheme   LoyaltyScheme @relation(fields: [schemeId], references: [id])
  @@map("customer_scheme_enrollments")
}

model Employee {
  id               String    @id @default(cuid())
  userId           String    @unique
  applicationId    String?
  employeeCode     String    @unique
  branchId         String
  departmentId     String
  designationId    String
  employmentType   String    @default("PERMANENT")
  status           String    @default("ACTIVE")
  joinedAt         DateTime
  probationEndDate DateTime?
  confirmedAt      DateTime?
  reportsTo        String?
  currentCtc       Float
  exitDate         DateTime?
  exitReason       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?

  user               User              @relation(fields: [userId], references: [id])
  branch             Branch            @relation(fields: [branchId], references: [id])
  department         Department        @relation(fields: [departmentId], references: [id])
  designation        Designation       @relation(fields: [designationId], references: [id])
  attendance         Attendance[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  payroll            Payroll[]
  performanceReviews PerformanceReview[]
  targets            EmployeeTarget[]
  trainingRecords    TrainingRecord[]
  repairAssignments  RepairAssignment[]
  interviewsGiven    Interview[] @relation("InterviewerEmployee")
  @@map("employees")
}

model Attendance {
  id              String    @id @default(cuid())
  employeeId      String
  branchId        String
  date            DateTime
  shiftId         String?
  checkIn         DateTime?
  checkOut        DateTime?
  source          String    @default("MANUAL")
  status          String    @default("PRESENT")
  lateMinutes     Int?
  overtimeMinutes Int?
  approvedBy      String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  shift    Shift?   @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date])
  @@map("attendance")
}

model LeaveType {
  id                  String   @id @default(cuid())
  name                String
  code                String   @unique
  isPaid              Boolean  @default(true)
